{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "UserPromptSubmit": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/Projects/nerv/hooks/flowmo-updates.sh",
                        "description": "Once a day, fetch flowmo and report new upstream commits (never pulls)"
                    },
                    {
                        "type": "command",
                        "command": "bash $HOME/projects/nerv/hooks/audience-gate.sh",
                        "description": "NERV v2 Jev audience detection — reinforces tone-of-voice for outward-facing text"
                    },
                    {
                        "type": "command",
                        "command": "bash $HOME/projects/nerv/hooks/memory-recall.sh",
                        "description": "NERV v2 Layer 4 — injects relevant knowledge from memory filesystem into session context"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/require-eff-review.sh",
                        "description": "MANDATORY FE Phase 7.5 gate: block git push of a FLOW-/HOR- feature branch until a committed, fresh specs/<TICKET>/eff-review-findings.json exists"
                    },
                    {
                        "type": "command",
                        "command": "bash $HOME/projects/nerv/hooks/risk-gate.sh",
                        "description": "NERV v2 Jev risk-gate — warns on destructive/irreversible operations before execution"
                    }
                ]
            },
            {
                "matcher": "mcp__*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/projects/nerv/hooks/guard-gate.sh",
                        "description": "NERV v2 Laya guard — scans MCP tool inputs for prompt injection"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash $HOME/projects/nerv/hooks/memory-persist.sh",
                        "description": "NERV v2 Layer 4 — saves research findings from session handoff to memory filesystem"
                    }
                ]
            }
        ]
    }
}
