#!/usr/bin/env bash
# ai-kernel-card — retrieve a memory card by id.
#
# Usage:
#   ai-kernel-card <id>             # full file (frontmatter + body)
#   ai-kernel-card <id> --body      # body only (frontmatter stripped)
#   ai-kernel-card <id> --path      # just the path (machine-friendly)
#   ai-kernel-card <id> --json      # the card's index entry as JSON
#
# Exits non-zero with a clear error if the id does not exist or the
# referenced file is missing.

set -euo pipefail
# shellcheck source=../config/config.sh
source "$(dirname "$0")/../config/config.sh"

[[ $# -ge 1 ]] || ak_die "usage: ai-kernel-card <id> [--body|--path|--json]"

id="$1"; shift
mode="full"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --body) mode="body"; shift ;;
    --path) mode="path"; shift ;;
    --json) mode="json"; shift ;;
    --) shift; break ;;
    *) ak_die "unknown flag: $1" ;;
  esac
done

[[ -f "$AI_KERNEL_INDEX" ]] || ak_die "no index at $AI_KERNEL_INDEX — run ai-kernel-index"

# Resolve card → entry from index.
entry="$(jq -c --arg id "$id" '.cards[$id] // null' "$AI_KERNEL_INDEX")"
[[ "$entry" == "null" ]] && ak_die "no card with id: $id"

path="$(jq -r '.path // ""' <<<"$entry")"

case "$mode" in
  json)
    printf '%s\n' "$entry"
    ;;
  path)
    [[ -z "$path" ]] && ak_die "card $id has no path"
    printf '%s\n' "$path"
    ;;
  full)
    [[ -z "$path" ]] && ak_die "card $id has no path"
    [[ -f "$path" ]] || ak_die "card $id path missing on disk: $path"
    cat "$path"
    ;;
  body)
    [[ -z "$path" ]] && ak_die "card $id has no path"
    [[ -f "$path" ]] || ak_die "card $id path missing on disk: $path"
    awk '
      BEGIN { in_fm=0; past_fm=0 }
      NR==1 && /^---[[:space:]]*$/ { in_fm=1; next }
      in_fm && /^---[[:space:]]*$/ { in_fm=0; past_fm=1; next }
      !in_fm && past_fm { print }
      !in_fm && !past_fm && NR==1 { print; past_fm=1 }
      !in_fm && past_fm == 0 && NR > 1 { print }
    ' "$path"
    ;;
esac
