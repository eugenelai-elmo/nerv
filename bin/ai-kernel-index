#!/usr/bin/env bash
# ai-kernel-index — walk configured memory roots, emit index.json.
#
# Reads: $AI_KERNEL_CONFIG (memory.roots[], memory.index_path)
# Writes: $AI_KERNEL_INDEX (flat cards + inverted by_tag / by_term / by_scope)
#
# Card source of truth: markdown files with YAML frontmatter. See docs/frontmatter-spec.md.

set -euo pipefail
# shellcheck source=../config/config.sh
source "$(dirname "$0")/../config/config.sh"

TMP_INDEX="$(mktemp)"
trap 'rm -f "$TMP_INDEX"' EXIT

# Tokenize card body + title for inverted index. Lowercase, split on non-alnum, drop stopwords and short tokens.
tokenize() {
  tr '[:upper:]' '[:lower:]' \
    | tr -c '[:alnum:]' '\n' \
    | awk 'length($0) >= 3 && !/^(the|and|for|with|this|that|from|your|have|will|are|was|were|has|had|but|not|all|any|can|use|used|into|out|via|per|as|at|be|by|in|is|it|of|on|or|to)$/'
}

root_count=$(yq -r '.memory.roots | length' "$AI_KERNEL_CONFIG")
echo '{"generated_at":"","cards":{},"by_tag":{},"by_term":{},"by_scope":{}}' > "$TMP_INDEX"
jq --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.generated_at=$ts' "$TMP_INDEX" > "$TMP_INDEX.1" && mv "$TMP_INDEX.1" "$TMP_INDEX"

total=0
for (( i=0; i<root_count; i++ )); do
  root_path="$(ak_abs "$(ak_config ".memory.roots[$i].path")")"
  root_scope="$(ak_config ".memory.roots[$i].scope")"
  [[ -d "$root_path" ]] || { printf '  [skip] %s (not found)\n' "$root_path" >&2; continue; }

  while IFS= read -r -d '' md; do
    # Extract YAML frontmatter block (between leading --- markers) and convert to JSON
    fm_yaml="$(awk '
      BEGIN { in_fm=0 }
      NR==1 && /^---[[:space:]]*$/ { in_fm=1; next }
      in_fm && /^---[[:space:]]*$/ { exit }
      in_fm { print }
    ' "$md")"
    if [[ -n "$fm_yaml" ]]; then
      fm_json="$(printf '%s\n' "$fm_yaml" | yq -o=json -p=yaml '.' 2>/dev/null || echo '{}')"
    else
      fm_json='{}'
    fi
    [[ "$fm_json" == "null" || -z "$fm_json" ]] && fm_json='{}'

    id="$(jq -r '.id // ""' <<<"$fm_json")"
    if [[ -z "$id" ]]; then
      # Fall back to filename without .md
      id="$(basename "$md" .md)"
    fi

    title="$(jq -r '.title // ""' <<<"$fm_json")"
    [[ -z "$title" ]] && title="$id"

    scope="$(jq -r '.scope // ""' <<<"$fm_json")"
    [[ -z "$scope" ]] && scope="$root_scope"

    mtype="$(jq -r '.type // "knowledge"' <<<"$fm_json")"
    confidence="$(jq -r '.confidence // "extracted"' <<<"$fm_json")"
    expires_val="$(jq -c '.expires // null' <<<"$fm_json")"
    tags_json="$(jq -c '(.tags // []) | if type == "array" then . else [] end' <<<"$fm_json")"
    related_json="$(jq -c '(.related // []) | if type == "array" then . else [] end' <<<"$fm_json")"

    hash="$(ak_hash_body "$md")"
    mtime="$(stat -f '%Sm' -t '%Y-%m-%dT%H:%M:%SZ' "$md" 2>/dev/null || stat -c '%y' "$md" 2>/dev/null | awk '{print $1"T"$2"Z"}')"

    # For repo-scoped cards, derive the namespace owner from the path:
    # <root>/<reponame>/anything.md → repo_ns="<reponame>". Empty otherwise.
    repo_ns=""
    if [[ "$scope" == "repo" ]]; then
      rel="${md#$root_path/}"
      repo_ns="${rel%%/*}"
    fi

    # Upsert card
    jq \
      --arg id "$id" \
      --arg path "$md" \
      --arg title "$title" \
      --arg scope "$scope" \
      --arg repo "$repo_ns" \
      --arg mtype "$mtype" \
      --arg confidence "$confidence" \
      --arg hash "$hash" \
      --arg mtime "$mtime" \
      --argjson expires "$expires_val" \
      --argjson tags "$tags_json" \
      --argjson related "$related_json" \
      '.cards[$id] = {
          path:$path, title:$title, scope:$scope, repo:$repo, type:$mtype, confidence:$confidence,
          tags:$tags, related:$related, hash:$hash, mtime:$mtime, expires:$expires
       }' "$TMP_INDEX" > "$TMP_INDEX.1" && mv "$TMP_INDEX.1" "$TMP_INDEX"

    # by_tag
    for tag in $(jq -r '.[]' <<<"$tags_json"); do
      jq --arg id "$id" --arg tag "$tag" \
        '.by_tag[$tag] = ((.by_tag[$tag] // []) + [$id] | unique)' \
        "$TMP_INDEX" > "$TMP_INDEX.1" && mv "$TMP_INDEX.1" "$TMP_INDEX"
    done

    # by_scope
    jq --arg id "$id" --arg scope "$scope" \
      '.by_scope[$scope] = ((.by_scope[$scope] // []) + [$id] | unique)' \
      "$TMP_INDEX" > "$TMP_INDEX.1" && mv "$TMP_INDEX.1" "$TMP_INDEX"

    # by_term — tokenize title + body (frontmatter-stripped), collect top terms
    terms="$(
      {
        printf '%s\n' "$title"
        awk 'BEGIN{fm=0} NR==1 && /^---[[:space:]]*$/ {fm=1; next} fm && /^---[[:space:]]*$/ {fm=0; next} !fm {print}' "$md"
      } | tokenize | sort -u
    )"
    while IFS= read -r term; do
      [[ -z "$term" ]] && continue
      jq --arg id "$id" --arg term "$term" \
        '.by_term[$term] = ((.by_term[$term] // []) + [$id] | unique)' \
        "$TMP_INDEX" > "$TMP_INDEX.1" && mv "$TMP_INDEX.1" "$TMP_INDEX"
    done <<<"$terms"

    total=$((total+1))
  done < <(find -L "$root_path" -type f -name '*.md' -not -path '*/archive/*' -print0)
done

mkdir -p "$(dirname "$AI_KERNEL_INDEX")"
mv "$TMP_INDEX" "$AI_KERNEL_INDEX"
trap - EXIT

card_count=$(jq -r '.cards | length' "$AI_KERNEL_INDEX")
tag_count=$(jq -r '.by_tag | length' "$AI_KERNEL_INDEX")
term_count=$(jq -r '.by_term | length' "$AI_KERNEL_INDEX")
printf 'indexed %d cards · %d tags · %d terms → %s\n' "$card_count" "$tag_count" "$term_count" "$AI_KERNEL_INDEX"
