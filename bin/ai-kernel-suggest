#!/usr/bin/env bash
# ai-kernel-suggest — Claude Code hook entry-point + manual query CLI.
#
# Computes the default scope from $PWD basename, builds a task.json,
# pipes it through ai-kernel-triage, and formats surfaced cards as a
# <system-reminder> block on stdout. Silent no-op when no per-repo
# namespace exists or no cards match.
#
# Usage:
#   ai-kernel-suggest --init                # manual: empty-query session ping
#   ai-kernel-suggest --query "<text>"      # manual: explicit query
#   ai-kernel-suggest --cc-prompt-hook      # CC UserPromptSubmit hook —
#                                           # reads stdin JSON, extracts .prompt
#
# Override (for tests):
#   AI_KERNEL_MEMORY_REPOS_ROOT — directory containing repos/<name>/ namespaces

set -euo pipefail
# shellcheck source=../config/config.sh
source "$(dirname "$0")/../config/config.sh"

mode="init"
query=""
include_personal="false"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --init)             mode="init";  shift ;;
    --query)
      [[ $# -ge 2 ]] || ak_die "--query requires a value"
      mode="query"; query="$2"; shift 2 ;;
    --cc-prompt-hook)   mode="cc-prompt-hook"; shift ;;
    --include-personal) include_personal="true"; shift ;;
    --) shift; break ;;
    *) ak_die "unknown flag: $1" ;;
  esac
done

# CC UserPromptSubmit hook: read JSON from stdin, extract .prompt.
# Hook input shape (CC docs):
#   {"session_id":"...","cwd":"...","hook_event_name":"UserPromptSubmit","prompt":"..."}
if [[ "$mode" == "cc-prompt-hook" ]]; then
  hook_input="$(cat 2>/dev/null || true)"
  [[ -z "$hook_input" ]] && exit 0
  query="$(jq -r '.prompt // ""' <<<"$hook_input" 2>/dev/null || true)"
  [[ -z "$query" ]] && exit 0
  mode="query"
fi

# Resolve repo name and namespace dir.
repo_name="$(basename "$PWD")"
repos_root="${AI_KERNEL_MEMORY_REPOS_ROOT:-$AI_KERNEL_ROOT/memory/repos}"
namespace_dir="$repos_root/$repo_name"

# Silent no-op when no namespace.
[[ -d "$namespace_dir" ]] || exit 0

# Build scope list.
scopes="global,repo"
[[ "$include_personal" == "true" ]] && scopes="$scopes,personal"

# Build task.json.
case "$mode" in
  init)  task_kind="nudge-query" ;;
  query) task_kind="pre-tool-use" ;;
esac
task="$(jq -n --arg kind "$task_kind" --arg q "$query" --arg repo "$repo_name" \
  '{ kind: $kind, query: $q, context: { source: "suggest", repo: $repo } }')"

# Triage. --repo restricts repo-scoped cards to this repo's namespace
# (without it, cards from other repos in memory/repos/* would leak through).
decision="$(printf '%s' "$task" | "$AI_KERNEL_ROOT/bin/ai-kernel-triage" \
  --scope "$scopes" --repo "$repo_name")"

# Format surface_cards as <system-reminder>.
card_count="$(jq -r '.surface_cards | length' <<<"$decision")"
[[ "$card_count" == "0" ]] && exit 0

# One jq pass over the index to look up title + scope for every surfaced card.
# Emits TAB-separated "id<TAB>scope<TAB>title" lines. Fallbacks: scope="?",
# title=id. If jq fails entirely (e.g. malformed index), fall back to id-only.
rows="$(jq -r --argjson dec "$decision" '
  ($dec.surface_cards) as $ids
  | .cards as $cards
  | $ids[]
  | . as $id
  | [$id, ($cards[$id].scope // "?"), ($cards[$id].title // $id)]
  | @tsv
' "$AI_KERNEL_INDEX" 2>/dev/null || jq -r '.surface_cards[] | [., "?", .] | @tsv' <<<"$decision")"

{
  printf '<system-reminder>\n'
  printf 'AI Kernel — relevant memory cards for repo "%s"%s:\n' "$repo_name" \
    "$([[ -n "$query" ]] && printf ' (query: %s)' "$query")"
  while IFS=$'\t' read -r id scope title; do
    [[ -z "$id" ]] && continue
    # Sanitize title for system-reminder safety.
    title="${title//$'\n'/ }"
    title="${title//$'\r'/ }"
    title="${title//<\/system-reminder>/[sr]}"
    printf '  - %s [%s] — %s\n' "$id" "$scope" "$title"
  done <<<"$rows"
  printf 'Query via: %s/bin/ai-kernel-triage\n' "$AI_KERNEL_ROOT"
  printf '</system-reminder>\n'
}
