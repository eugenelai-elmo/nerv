#!/usr/bin/env bash
# ai-kernel-triage — the decider.
#
# Reads a task.json on stdin, emits a decision.json on stdout.
# Rules live in config (triage.rules + triage.default).
# The tiering invariant: triage may never spend more than max_self_spend.
# MVP: pure case-statement routing + inverted-index lookup. No LLM calls.
#
# task.json shape:
#   { "kind": "<kind>", "query": "<free text>", "context": {...} }
#
# decision.json shape:
#   { "tier": "tier0|tier1|tier2|tier3|tier4",
#     "surface_cards": ["<id>", ...],
#     "action": "nudge|dispatch|skip",
#     "rationale": "<why>" }

set -euo pipefail
# shellcheck source=../config/config.sh
source "$(dirname "$0")/../config/config.sh"

# ── Optional filters: --scope a,b,c · --repo <name> ────────────────────────
allowed_scopes=""
repo_filter=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --scope)
      [[ $# -ge 2 ]] || ak_die "--scope requires a value"
      [[ -n "$2" ]]  || ak_die "--scope value cannot be empty"
      allowed_scopes="$2"; shift 2 ;;
    --repo)
      [[ $# -ge 2 ]] || ak_die "--repo requires a value"
      [[ -n "$2" ]]  || ak_die "--repo value cannot be empty"
      repo_filter="$2"; shift 2 ;;
    --) shift; break ;;
    *) ak_die "unknown flag: $1" ;;
  esac
done

task="$(cat)"
[[ -z "$task" ]] && ak_die "empty stdin — pipe a task.json"

kind="$(jq -r '.kind // ""' <<<"$task")"
query="$(jq -r '.query // ""' <<<"$task")"

# ── Rule lookup: triage.rules[kind], fallback to triage.default ──────────────
rule_tier="$(AK_KIND="$kind" yq -r '.triage.rules[strenv(AK_KIND)] // .triage.default // "tier2"' "$AI_KERNEL_CONFIG")"

# ── Invariant: triage itself must never exceed max_self_spend ───────────────
# (The chosen tier is for the dispatched work, not for triage itself, so this
# invariant is informational at MVP — will bite once triage recurses into an
# LLM fallback in v2.)
max_self="$(yq -r '.triage.max_self_spend // "tier1"' "$AI_KERNEL_CONFIG")"

# ── Surface cards: inverted-index lookup over query tokens ──────────────────
surface_cards='[]'
if [[ -n "$query" && -f "$AI_KERNEL_INDEX" ]]; then
  # tokenize query → intersect hits across by_term
  tokens="$(printf '%s' "$query" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c '[:alnum:]' '\n' \
    | awk 'length($0) >= 3 && !/^(the|and|for|with|this|that|from|your|have|will|are|was|were|has|had|but|not|all|any|can|use|used|into|out|via|per|as|at|be|by|in|is|it|of|on|or|to)$/' \
    | sort -u)"
  if [[ -n "$tokens" ]]; then
    # For each token, get its card list; union them, weight by hit count.
    surface_cards="$(
      while IFS= read -r tok; do
        [[ -z "$tok" ]] && continue
        jq -r --arg t "$tok" '(.by_term[$t] // [])[]' "$AI_KERNEL_INDEX" 2>/dev/null || true
      done <<<"$tokens" \
      | sort | uniq -c | sort -rn | head -5 | awk '{print $2}' \
      | jq -R . | jq -s .
    )"
    [[ -z "$surface_cards" || "$surface_cards" == "null" ]] && surface_cards='[]'
  fi
fi

# ── Scope filter (if requested) ─────────────────────────────────────────────
if [[ -n "$allowed_scopes" && "$(jq -r 'length' <<<"$surface_cards")" -gt 0 && -f "$AI_KERNEL_INDEX" ]]; then
  surface_cards="$(
    jq --argjson cards "$surface_cards" --arg scopes "$allowed_scopes" '
      ($scopes | split(",")) as $allow
      | . as $idx
      | [ $cards[]
          | . as $id
          | select(($idx.cards[$id].scope // "") | IN($allow[])) ]
    ' "$AI_KERNEL_INDEX"
  )"
fi

# ── Repo namespace filter (if requested) ────────────────────────────────────
# When --repo is set, repo-scoped cards are dropped unless their .repo matches.
# Other scopes (global, personal) pass through unchanged.
if [[ -n "$repo_filter" && "$(jq -r 'length' <<<"$surface_cards")" -gt 0 && -f "$AI_KERNEL_INDEX" ]]; then
  surface_cards="$(
    jq --argjson cards "$surface_cards" --arg repo "$repo_filter" '
      . as $idx
      | [ $cards[]
          | . as $id
          | ($idx.cards[$id]) as $c
          | select(($c.scope // "") != "repo" or ($c.repo // "") == $repo) ]
    ' "$AI_KERNEL_INDEX"
  )"
fi

# ── Action: nudge if we have cards to surface; dispatch for real work ───────
action="dispatch"
case "$kind" in
  nudge-query|pre-tool-use) action="nudge" ;;
  hash-check|empty-check|mtime-check) action="dispatch" ;;
  "") action="skip" ;;
esac

rationale="rule matched: kind='$kind' → $rule_tier"
if [[ "$(jq -r 'length' <<<"$surface_cards")" -gt 0 ]]; then
  rationale="$rationale; surfaced $(jq -r 'length' <<<"$surface_cards") card(s)"
fi

decision="$(jq -n \
  --arg tier "$rule_tier" \
  --argjson cards "$surface_cards" \
  --arg action "$action" \
  --arg rationale "$rationale" \
  --arg max_self "$max_self" \
  '{ tier: $tier, surface_cards: $cards, action: $action, rationale: $rationale,
     _meta: { max_self_spend: $max_self } }')"

# Append to decisions log (path overridable for tests).
# Failure modes intentionally swallowed: log dir unwritable, disk full.
# We do NOT swallow jq schema errors — those would mask real bugs.
log="${AI_KERNEL_DECISIONS_LOG:-$AI_KERNEL_ROOT/decisions.jsonl}"
mkdir -p "$(dirname "$log")" 2>/dev/null || true
log_line="$(jq -cn \
  --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson task "$task" \
  --argjson dec  "$decision" \
  '{ ts: $ts, task: $task, decision: $dec }')"
printf '%s\n' "$log_line" >> "$log" 2>/dev/null || true

printf '%s\n' "$decision"
