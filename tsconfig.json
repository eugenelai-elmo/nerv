{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "providers/**/*.ts", "spikes/**/*.ts", "checks/**/*.ts", "hooks/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
